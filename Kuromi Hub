local Win = Instance.new("Frame", Gui)
Win.Size, Win.Position, Win.AnchorPoint, Win.BackgroundColor3, Win.Visible = UDim2.new(0, 520, 0, 320), UDim2.new(0.5, 0, 0.5, 0), Vector2.new(0.5, 0.5), Color3.fromRGB(15, 12, 15), false
Instance.new("UICorner", Win).CornerRadius = UDim.new(0, 10)

local Bg = Instance.new("ImageLabel", Win)
Bg.Size, Bg.BackgroundTransparency, Bg.Visible, Bg.ZIndex = UDim2.new(1, 0, 1, 0), 1, false, 0

local Sb = Instance.new("ScrollingFrame", Win)
Sb.Size, Sb.Position, Sb.BackgroundTransparency, Sb.CanvasSize = UDim2.new(0, 160, 1, -60), UDim2.new(0, 12, 0, 50), 1, UDim2.new(0, 0, 0, 800)
Instance.new("UIListLayout", Sb).Padding = UDim.new(0, 4)

local Content = Instance.new("Frame", Win)
Content.Size, Content.Position, Content.BackgroundTransparency = UDim2.new(1, -200, 1, -60), UDim2.new(0, 185, 0, 50), 1

local currFont = Enum.Font.SourceSans
local function applyFont()
    for _, v in ipairs(Gui:GetDescendants()) do
        if v:IsA("TextLabel") or v:IsA("TextButton") or v:IsA("TextBox") then
            pcall(function() v.Font = currFont end)
        end
    end
end

local function addTab(name, callback)
    local btn = Instance.new("TextButton", Sb)
    btn.Size, btn.BackgroundColor3, btn.Text, btn.TextColor3, btn.Font = UDim2.new(1, 0, 0, 32), Color3.fromRGB(25, 18, 22), "   " .. name, Color3.fromRGB(200, 200, 200), currFont
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    
    local page = Instance.new("ScrollingFrame", Content)
    page.Size, page.BackgroundColor3, page.BackgroundTransparency, page.Visible, page.CanvasSize = UDim2.new(1, 0, 1, 0), Color3.fromRGB(25, 18, 22), 0.3, false, UDim2.new(0, 0, 0, 700)
    Instance.new("UICorner", page).CornerRadius = UDim.new(0, 8)
    Instance.new("UIListLayout", page).Padding = UDim.new(0, 6)
    
    callback(page)
    btn.MouseButton1Click:Connect(function()
        for _, c in pairs(Content:GetChildren()) do if c:IsA("ScrollingFrame") then c.Visible = false end end
        page.Visible = true
    end)
end

